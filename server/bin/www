#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('server:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

// attach Socket.IO for real-time events (skip in serverless environments like Vercel)
if (!process.env.VERCEL) {
  try {
    const { Server } = require('socket.io');
    const io = new Server(server, {
      cors: { origin: process.env.CLIENT_ORIGIN || '*', methods: ['GET', 'POST', 'PATCH'] }
    });
    // Socket authentication
    io.use((socket, next) => {
      const token = socket.handshake.auth?.token;
      if (!token) {
        return next(new Error('Authentication error'));
      }
      try {
        const jwt = require('jsonwebtoken');
        const payload = jwt.verify(token, process.env.JWT_SECRET || 'replace_this_secret_in_env');
        socket.user = payload;
        next();
      } catch (err) {
        next(new Error('Authentication error'));
      }
    });
    // make io available on app if needed
    app.set('io', io);
    // forward internal events to socket.io clients
    const events = require('../lib/events');
    events.on('order_created', (order) => { console.log('emitting order_created', order._id); io.emit('order_created', order); });
    events.on('order_updated', (order) => { console.log('emitting order_updated', order._id); io.emit('order_updated', order); });
    events.on('product_created', (p) => { console.log('emitting product_created', p.id); io.emit('product_created', p); });
    events.on('product_updated', (p) => { console.log('emitting product_updated', p.id); io.emit('product_updated', p); });
    events.on('product_deleted', (id) => { console.log('emitting product_deleted', id); io.emit('product_deleted', id); });
    console.log('📱 Socket.IO initialized');
  } catch (e) {
    console.warn('⚠️  Socket.IO not initialized:', e && e.message);
  }
} else {
  console.log('📱 Socket.IO skipped in serverless environment');
}

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
  
  // Display clear port information
  console.log('🚀 Server is running!');
  console.log('📍 Port:', addr.port);
  console.log('🌐 Local: http://localhost:' + addr.port);
  console.log('🔗 API Base URL: http://localhost:' + addr.port + '/api');
  console.log('📱 Socket.IO: Enabled');
}
